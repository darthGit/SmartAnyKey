# Supabase — local self-host stack (docker/): kong on 8000.
# Keys come from docker/.env (ANON_KEY / SERVICE_ROLE_KEY)
SUPABASE_URL=http://localhost:8000
SUPABASE_KEY=
# service_role: used ONLY server-side (@nuxtjs/supabase serviceKey)
SUPABASE_SERVICE_KEY=

# guacd for the ws bridge (ADR-010). The BFF bridges browser↔guacd directly — json-auth
# and the guac web app are removed. Defaults 127.0.0.1:4822 (guacd publishes the port
# locally, docker/docker-compose.yml); set only if guacd lives elsewhere.
# NUXT_GUACD_HOST=127.0.0.1
# NUXT_GUACD_PORT=4822

# Asterisk/FreePBX webhook (shared secret for call-event POSTs)
PBX_WEBHOOK_SECRET=

# Credential manager — AES-256-GCM at-rest key (ADR-009).
# 64 hex chars (32 bytes): openssl rand -hex 32. NEVER commit a real one.
NUXT_CRED_ENCRYPTION_KEY=<64-hex>

# Local-task executor (ADR-016). The BFF sends local tasks
# to the executor service. URL defaults to 127.0.0.1:8090 (the executor publishes the port
# locally, like guacd). SECRET must match docker/.env EXECUTOR_SHARED_SECRET.
# NUXT_EXECUTOR_URL=http://127.0.0.1:8090/run
NUXT_EXECUTOR_SECRET=<shared-secret>

# Registry of task runners. JSON `runtime → URL`.
# Empty/unset = no runner, i.e. tasks cannot be created: which runtimes
# an installation has is its property, not our knowledge (no domain defaults).
# Endpoint `/run-task` (streaming, with an environment cache) — NOT the legacy `/run`
# that device local commands use. Right now all three runtimes ship in ONE image
# (`executor/`, recipes.json); another version or another runner type (ansible) =
# a separate image + one more line here, no code change.
NUXT_TASK_RUNNERS={"python312":"http://127.0.0.1:8090/run-task","node22":"http://127.0.0.1:8090/run-task","bash":"http://127.0.0.1:8090/run-task"}

# Reverse lookup "caller number → point".
# How many trailing phone digits are enough for a match — so that
# +380671234567 and 0671234567 find the same point. Empty/unset =
# exact match only. There is deliberately no default in code: the length of the national
# part of a number is a property of the deployment's country, not our knowledge.
# For Ukraine: 9.
# NUXT_PUBLIC_ — the same value is read by both the BFF lookup and the client-side board
# search; two separate keys would drift apart.
NUXT_PUBLIC_PHONE_MATCH_TAIL=

# External address of the app. Used only where
# a person reads the link outside the browser: `runUrl` in the sink notification body
# ("open the run" from Telegram). Empty = the field is not added.
# NUXT_PUBLIC_APP_URL=https://sak.your-org.example
