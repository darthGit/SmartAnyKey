# graphify was dropped 2026-09-17. The line below stays as a safeguard: the
# skill is still in the developer's global profile, and an accidental run must
# not put 27 MB of artifacts into git.

# Local Claude Code permissions (one per developer)
.claude/settings.local.json

# Common scratch
*.log
.DS_Store

# Nuxt
node_modules/
.nuxt/
.output/
dist/
.env

# Local infra secrets & runtime data (docker compose)
docker/.env
# Data dirs from before infra-trim (now named volumes) — may still sit on dev machines.
docker/volumes/

# Playwright MCP artifacts
.playwright-mcp/

# Graphify: regenerated by the post-commit hook on every commit → not tracked
graphify-out/

# @nuxt/test-utils generated marker
.nuxtrc

# Byte-compiled Python left by importing a tooling script for a measurement.
__pycache__/
*.pyc

# Ad-hoc screenshots taken while verifying UI land in the repo root.
/*.png
