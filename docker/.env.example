############
# Secrets
#
# `scripts/bootstrap.mjs` (run by install.sh) replaces every secret below with
# a generated one; the values here are public demo values every install would share.
# Removed relative to upstream (pinned in the header of docker-compose.yml): the
# dashboard, pooler, functions, imgproxy, analytics/vector, MinIO and TLS-proxy blocks.
#
############

# Postgres
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# Legacy symmetric HS256 key
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
# Legacy API keys (HS256-signed JWTs)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Asymmetric key pair (ES256) and opaque API keys
#
# Documentation:
# https://supabase.com/docs/guides/self-hosting/self-hosted-auth-keys
#
# Opaque API key for client-side use (anon role).
SUPABASE_PUBLISHABLE_KEY=
# Opaque API key for server-side use (service_role). Never expose in client code.
SUPABASE_SECRET_KEY=
# JSON array of signing JWKs (EC private + legacy symmetric).
# Used by Auth.
JWT_KEYS=
# JWKS for token verification (EC public + legacy symmetric).
# Used by PostgREST, Realtime, Storage to verify tokens.
JWT_JWKS=

# Encryption key for securing Realtime communications.
# (Must be at least 64 characters; generate with: openssl rand -base64 48)
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq

# Encryption key used by Realtime for sensitive fields in the `_realtime` schema.
# (Must be exactly 16 characters; generate with: `openssl rand -hex 8`)
REALTIME_DB_ENC_KEY=supabaserealtime

# Encryption key for securing connection strings used by Studio against postgres-meta.
# (Must be at least 32 characters; generate with openssl rand -base64 24)
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min

# Access key ID (username-like) for accessing the S3 protocol endpoint in Storage.
# (Generate with: openssl rand -hex 16)
S3_PROTOCOL_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
# Secret key (password-like) used with S3_PROTOCOL_ACCESS_KEY_ID.
# (Generate with: openssl rand -hex 32)
S3_PROTOCOL_ACCESS_KEY_SECRET=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907


############
# URLs - Configure hostnames below to reflect your actual domain name
############

# Public address of the API gateway (Kong)
SUPABASE_PUBLIC_URL=http://localhost:8000

# Supabase address used by both the browser and the app container itself: the server-side
# client goes to the same public address.
# ⚠ Empty = the app detects it itself (first non-loopback IPv4) and says
# out loud in the log what it picked. That is why this is NOT
# `http://localhost:8000`: `localhost` in a container = the container itself, every
# gated route returns 500, and with a non-empty value auto-detection never
# runs (measured live in a clean room 2026-09-18 — it did not run).
# Set it only when the machine has several NICs and auto-selection picks the wrong one:
# SAK_PUBLIC_SUPABASE_URL=http://192.0.2.10:8000
SAK_PUBLIC_SUPABASE_URL=

# Which app release to run and on which port to serve it.
# Where to pull images from. The registry is a property of the installation, not our knowledge:
# an air-gapped site sets its own (Harbor, registry:2, internal GitLab) and changes
# only these two lines. Verified end to end 2026-09-17 on a local registry:2.
SAK_IMAGE=ghcr.io/darthgit/smartanykey-app
SAK_EXECUTOR_IMAGE=ghcr.io/darthgit/smartanykey-executor
SAK_TAG=latest
SAK_PORT=3000

# Full external URL of the Auth service, used to construct OAuth callbacks,
# SAML endpoints, and email links
API_EXTERNAL_URL=http://localhost:8000/auth/v1

# See also the Auth section below for Site URL and Redirect URLs configuration


############
# Database - Postgres configuration
############

# Using default user (postgres)
POSTGRES_HOST=db
POSTGRES_DB=postgres

# Port Postgres listens on inside the compose network. Not published on the host.
POSTGRES_PORT=5432


############
# Studio — read only by the dev overlay (docker-compose.dev.yml)
############

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project

# Add your OpenAI API key to enable AI Assistant
OPENAI_API_KEY=sk-proj-xxxxxxxx


############
# Auth - Configuration for the authentication server
############

## General settings

# Equivalent to "Site URL" and "Redirect URLs" platform configuration options
# Documentation: https://supabase.com/docs/guides/auth/redirect-urls
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

JWT_EXPIRY=3600

## Mailer Config
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

## Email auth
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false

## Phone auth
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

############
# Storage - Configuration for Storage
############

# Check the S3_PROTOCOL_ACCESS_KEY_ID/SECRET above, and
# refer to the documentation at:
# https://supabase.com/docs/guides/self-hosting/self-hosted-s3
# to learn how to configure the S3 protocol endpoint

# S3 bucket when using S3 backend, directory name when using 'file'
GLOBAL_S3_BUCKET=stub

# Used for S3 protocol endpoint configuration
REGION=stub

# Equivalent to project_ref as described here:
# https://supabase.com/docs/guides/storage/s3/authentication#session-token
STORAGE_TENANT_ID=stub


############
# API - Configuration for PostgREST
############

# Postgres schemas exposed via the REST API
PGRST_DB_SCHEMAS=public,storage,graphql_public

# Max number of rows returned by a request
PGRST_DB_MAX_ROWS=1000

# Extra schemas added to the search_path of every request
PGRST_DB_EXTRA_SEARCH_PATH=public


############
# API gateway
############

# Kong configuration variables
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Used internally by the API gateway - DO NOT use in any client or server code.
# Pre-signed ES256 JWT "API key" for anon role.
ANON_KEY_ASYMMETRIC=
# Pre-signed ES256 JWT "API key" for service_role.
SERVICE_ROLE_KEY_ASYMMETRIC=


############
# SmartAnyKey: Guacamole (ADR-010 — guacd-only, no web app/json-auth)
############

# Only guacd (the engine) remains. The guacamole/guacamole web app and
# GUACAMOLE_JSON_SECRET_KEY are removed — the BFF bridges browser↔guacd directly.
# guacd publishes 4822 on the host only in docker-compose.dev.yml (host-side pnpm dev).

############
# SmartAnyKey: RBAC bootstrap default-admin (ADR-013)
############

# ⚠ Empty on purpose (ADR-021). The normal path is the
# `/setup` screen in the browser: `install.sh` calls `seed-admin.mjs` ONLY when
# both variables are non-empty. With a filled-in example every fresh install would silently
# get an admin with a publicly known password, and `/setup` would never appear
# at all — measured in a clean room 2026-09-18 (`admin seeded:
# admin@example.com`). The same problem for which the admin was once
# removed from migration `0009`.
# Set only for an unattended install (CI, a repeatable test bench):
#   RBAC_ADMIN_EMAIL=admin@your-org.example
#   RBAC_ADMIN_PASSWORD=<strong password>
RBAC_ADMIN_EMAIL=
RBAC_ADMIN_PASSWORD=

# Local-task executor (ADR-016). Shared secret between the BFF and the executor service —
# must match root .env NUXT_EXECUTOR_SECRET. openssl rand -hex 24.
EXECUTOR_SHARED_SECRET=change-me-executor-secret

# Registry of scheduled-task runtimes (ADR-018): JSON {"runtime":"runner URL"}.
# ⚠ Do NOT leave empty. Measured 2026-09-21 in a clean room (three arms, one
# variable): with an empty value the scheduler does nothing — the trigger is not
# claimed, `task_run` is empty, the log is silent. So both the backup
# (a built-in task) and `discovery:rescan` (ADR-015) silently turn off, not just "create
# a task". The default below = the runtimes our executor image ships
# (`executor/recipes.json`); tests/delivery/task-runners.spec.ts keeps them from drifting.
# Install without an executor — keep the value: the scheduler is needed by built-in
# tasks, runner tasks simply will not start.
# The path must be /run-task (legacy /run = `runner 400: bad interpreter`).
NUXT_TASK_RUNNERS={"python312":"http://executor:8090/run-task","node22":"http://executor:8090/run-task","bash":"http://executor:8090/run-task"}

# The session cookie is sent as Secure only over TLS (ADR-019). An http install —
# leave empty/`false`, otherwise the browser drops the cookie and login does not persist.
NUXT_PUBLIC_SUPABASE_COOKIE_OPTIONS_SECURE=false

# --- Rate limits (per minute) -----------------------------------------------
# Sign-in attempts (password and token refresh) per client IP, enforced by Kong. Over the
# limit the login page says "try again in a minute". Behind a reverse proxy every client
# shares the proxy's address — raise this or limit at the proxy.
SAK_LOGIN_RATE_PER_MIN=10
# Remote sessions (SSH terminal, VNC/RDP) a user may open per minute. A technician opens
# panes by hand; 30 leaves room for a full mosaic and stops a scripted token.
SAK_SESSION_OPEN_PER_MIN=30
# First-admin setup (per IP) and own password change (per user).
SAK_AUTH_ACTION_PER_MIN=5

# --- Backup ------------------------------------------------------------------
# Where the `app` container puts dumps on the host. Empty = the managed volume
# `sak-backups` (to fetch: `docker run --rm -v smartanykey_sak-backups:/b -v "$PWD":/out
# alpine cp -r /b /out`). An absolute path (e.g. /srv/sak-backups) = bind mount.
# Do not put it in the working tree: a dump clutters git status and the build context.
BACKUP_HOST_DIR=
# How many newest dumps to keep; the task deletes older ones itself.
BACKUP_KEEP=30
# The backup schedule is NOT set here — it lives in the task itself (/admin/tasks,
# toggle + cron). The task ships disabled.
